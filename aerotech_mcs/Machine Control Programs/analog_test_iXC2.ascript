// Reading Analog Input for Motion Checkpoints:
program

	// data collection parameters
	var $numSamples as integer = 100 * 1 * 1000
	// collect for 100 sec @ 1kHz
	//
	//  NOTE: WATCH FOR MEMORY OVERLOAD
	//
	var $sampleTime as real = 1.0
	// 1.0ms/1 sample = 1msec/sample
	var $filePath as string = "C:/Users/danie/OneDrive/Job Stuff/Chin_Research_2025-2026/LiCs_MCS/testanalog"
	var $fileName as string = $filePath + "/testanalog100mms"
	
	//Configure data collection format
	AppDataCollectionReset()
	AppDataCollectionAddAxisSignal(X, AxisDataSignal.PositionCommand)
	AppDataCollectionAddAxisSignal(X, AxisDataSignal.PositionFeedback)
	AppDataCollectionAddAxisSignal(X, AxisDataSignal.CurrentFeedback)
	AppDataCollectionAddAxisSignal(X, AxisDataSignal.AxisStatus)
	AppDataCollectionAddAxisSignal(X, AxisDataSignal.AnalogInput0)
	AppDataCollectionAddTaskSignal(1, TaskDataSignal.TaskState)

	AppDataCollectionConfigure($numSamples, $sampleTime)
	//Set # samples & time per sample
	AppDataCollectionAutoSaveOn($fileName, DataCollectionFileType.Csv)
	// autosave locally to $fileName as csv

	Enable(X)
	var $signal_resolution as real = 0.1 // V
	var $idle_stop_time as real = 2e5 // msec.
	var $stage_speed as real = 10.0 // mm/s
	var $accel as real = 1000.0 //mm/s^2
	
	SetupAxisRampType(X, RampType.Sine)
	SetupAxisRampValue(X, RampMode.Rate, $accel)
	
	//Start data collection @ homing phase:
	AppDataCollectionSnapshot()	
	Home(X)
	WaitForInPosition(X)
	
	// Loop: run for max $idle_stop_time sec., move by analog input V
	var $start_time = TimerRead(0, TimerMode.Standard)
	while (true)
		
		if (TimerRead(0, TimerMode.Standard) - $start_time >= $idle_stop_time)
			AppMessageDisplay("Loop Timeout")
			break
		end
		
		
		var $curr_analog_in as real = AnalogInputGet(X, 0)
		//var $curr_timer as real = TimerRead(0, TimerMode.Standard)
		//AppMessageDisplay("Analog Input (" + RealToString($curr_timer) + "):")
		//AppMessageDisplay(RealToString($curr_analog_in) + "V")
		
		if ($curr_analog_in <= 0.75+$signal_resolution)
			MoveAbsolute(X, -11.0, $stage_speed)
			WaitForInPosition(X)
		elseif (Abs($curr_analog_in) <= 1.5+$signal_resolution)
			MoveAbsolute(X, -6.0, $stage_speed)
			WaitForInPosition(X)
		elseif (Abs($curr_analog_in) <= 2.25+$signal_resolution)
			MoveAbsolute(X, 0.0, $stage_speed)
			WaitForInPosition(X)
		elseif (Abs($curr_analog_in) <= 3.0+$signal_resolution)
			MoveAbsolute(X, 6.0, $stage_speed)
			WaitForInPosition(X)
		elseif (Abs($curr_analog_in) <= 3.75+$signal_resolution)
			MoveAbsolute(X, 11.0, $stage_speed)
			WaitForInPosition(X)
		else
			AppMessageDisplay("Ending Run Loop")
			break
		end
	end
	
	MoveAbsolute(X, 0.0, $stage_speed)
	WaitForInPosition(X)
	
	AppDataCollectionStop()
	Disable(X)

end